; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="flappy bat adventure"
run/main_scene="uid://iwbtqm3nill0"
config/features=PackedStringArray("4.7", "Mobile")
run/stretch/mode="disabled"
run/canvas_textures/default_texture_filter=1

[audio]

buses/default_bus_layout="uid://bwgsvg5jw1qgs"

[autoload]

GameState="*uid://bsrlu7oykjtie"
PlayerFollower="*uid://bxjjoffjws3of"
TriggerHandler="*uid://cvqcb1bccm2hy"
SaveManager="*uid://dfh7c7mg0s30t"
ParticleManager="*uid://or6wn166kcu"
AudioManager="*uid://dk46gwrksu2ij"
SongManager="*uid://bais6bdh5c0hm"

[debug]

settings/stdout/print_fps=true

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/physics_interpolation=true
window/lossless_compression/force_png=false

[editor_plugins]

enabled=PackedStringArray("res://addons/ropesim/plugin.cfg")

[global_group]

coin=""
trigger="handles anything with triggers"
water=""
player=""
ground=""

[gui]

theme/custom_font="uid://dastaipla71ju"

